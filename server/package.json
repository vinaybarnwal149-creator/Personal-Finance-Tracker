{
  "name": "fintrack-server",
  "version": "1.0.0",
  "description": "FinTrack Express API Server",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testTimeout=20000",
    "seed": "node src/seeds/seed.js",
    "seed:reset": "node src/seeds/seed.js --reset",
    "clean:demo": "node src/scripts/clean-demo-data.js",
    "clean:all-except-demo": "node src/scripts/clean-demo-data.js --purge-all-except-demo"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.2.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
